# Sao chép thành .env và điền thông tin thật. KHÔNG commit file .env lên Git.

# --- Thiết bị Cisco (A) ---
NETSENTRY_USERNAME=
NETSENTRY_PASSWORD=
# Enable secret (để trống nếu tài khoản đã vào thẳng privilege 15)
NETSENTRY_ENABLE_SECRET=

# --- AI assistant (tuần 7). Khóa API chỉ nằm ở backend, không bao giờ gửi xuống frontend ---
# openai | gemini  (để trống => dùng giải thích dự phòng, không gọi LLM)
NETSENTRY_AI_PROVIDER=
# Tên model do bạn chọn (không có mặc định)
NETSENTRY_AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Timeout gọi LLM (giây)
NETSENTRY_AI_TIMEOUT=30
=======
