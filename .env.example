# NetSentry application
APP_NAME=NetSentry
APP_ENV=development

# Device connection defaults
DEVICE_TYPE=cisco_ios
DEVICE_PORT=22
DEVICE_TIMEOUT=10

# AI assistant (Member C). Default 'mock' = offline, free, no key.
ASSISTANT_PROVIDER=mock
# For a real free provider set ASSISTANT_PROVIDER=openai_compat and the three below. Examples:
#   Gemini : https://generativelanguage.googleapis.com/v1beta/openai   (key from Google AI Studio, free tier)
#   Groq   : https://api.groq.com/openai/v1                            (free tier)
#   Ollama : http://127.0.0.1:11434/v1                                 (local, no key)
# Model names/free limits change - check the provider's current docs.
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
